# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Base de prueba que arma tests/preparar.sh, con los datos reales importados.
# Vive dentro del repo —y no en /tmp— para que lo que prepara el hook de
# arranque sobreviva hasta la sesión. El venv va en .venv/ (arriba).
.datos-dev/

# Base de datos local (generada en runtime)
*.db
*.sqlite
*.sqlite3

# Excel diario del proveedor (se reemplaza cada día, no se versiona)
Excel/Proveedor/

# PDFs generados por la app (archivos de runtime, no código)
/Presupuestos/

# Builds y distribución
dist/
build/

# OS
Thumbs.db
desktop.ini

# Config local de Claude Code (permisos especificos de esta maquina)
.claude/settings.local.json

# Capturas que generan las verificaciones de UI (tests/ui_grupos.mjs)
tests/capturas/
